algoritmo "lista01-01"
//O programa deve pedir ao usuário dois números reais e exibir a soma total.
var
   soma, produto1, produto2: inteiro

inicio
   escreva("Digite o primeiro produto: ")
   leia(produto1)

   escreva("Digite o segundo produto: ")
   leia(produto2)

   soma <- (produto1 + produto2)
   
   escreva("A soma dos produtos é R$" , soma)

fimalgoritmo