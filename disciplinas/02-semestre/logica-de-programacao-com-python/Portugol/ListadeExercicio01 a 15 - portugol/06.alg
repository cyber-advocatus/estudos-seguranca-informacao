algoritmo "atividade06"
var
   numero: real// declare suas variáveis aqui

inicio

   escreva("Digite um número: ")
   leia(numero)
   antecessor <- numero - 1
   sucessor <- numero + 1
   escreval("O número digitado foi: ", numero)
   escreval("O antecessor de ", numero, " é: ", antecessor)
   escreval("O sucessor de ", numero, " é: ", sucessor)

fimalgoritmo