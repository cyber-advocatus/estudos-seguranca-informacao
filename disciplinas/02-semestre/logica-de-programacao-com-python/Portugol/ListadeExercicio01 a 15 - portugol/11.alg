algoritmo "atividade11"
var
   a, b, c, delta: real// declare suas variáveis aqui
inicio
   escreva("Digite o valor de a: ")
   leia(a)
   escreva("Digite o valor de b: ")
   leia(b)
   escreva("Digite o valor de c: ")
   leia(c)
   delta <- b * b - 4 * a * c
   escreval("O valor do delta é: ", delta)
fimalgoritmo