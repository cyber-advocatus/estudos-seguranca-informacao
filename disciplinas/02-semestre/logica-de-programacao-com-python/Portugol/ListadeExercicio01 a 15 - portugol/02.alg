algoritmo "atividade02"
// Disciplina   : [Linguagem e Lógica de Programação] 
// Professor   : Jean   Lima
// Estudante   : Luiz Otavio

Var
   nome : caracter
   
Inicio
   escreva("Qual é o seu nome: ")
   leia (nome)
   escreva ("Olá ", nome, ", é um prazer te conhecer!")
   

Fimalgoritmo
// Escreva um programa que leia o nome de uma pessoa e mostre
// uma mensagem de boas-vindas para ela
