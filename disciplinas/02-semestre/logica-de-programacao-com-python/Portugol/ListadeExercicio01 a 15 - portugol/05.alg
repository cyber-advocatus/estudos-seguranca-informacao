algoritmo "atividade05"
var
   nota1, nota2, media: real// declare suas variáveis aqui
inicio
   escreva("Digite a primeira nota: ")
   leia(nota1)
   escreva("Digite a segunda nota: ")
   leia(nota2)
   media := (nota1 + nota2) / 2
   escreva("A média entre ", nota1, " e ", nota2, " é igual a: ", media)
fimalgoritmo