algoritmo "NomeDoAlgoritmo"
var
   numero: real// declare suas variáveis aqui
inicio
   escreva("Digite um número: ")
   leia(numero)
   dobro <- (numero * 2)
   terca <- (numero / 3)
   escreval("O dobro do número digitado é: ", dobro)
   escreval("A terça parte do número digitado é: ", terca)

fimalgoritmo