Algoritmo "ex05"

Var
   numero: inteiro

Inicio
   escreva("Digite um número inteiro: ")
   leia (numero)
   se numero > 5 entao
      escreva ("O número é maior que cinco.")
   senao
      escreva ("O número é menor que cinco.")
   
   fimse

Fimalgoritmo
// Leia um número inteiro e imprima se ele é maior que cinco ou menor que cinco
