algoritmo "exemplo05"

//Imprimir na tela os números ímpares de 1  a 20 com condição,
//desta vez usando a estrutura de repetição "para".

var
 numeros: inteiro

inicio
   para numeros de 1 ate 20 faca
       se numeros mod 2 <> 0 entao
          escreva(numeros, " ")
       fimse
   fimpara

fimalgoritmo