algoritmo "exemplo04"

//Imprimir na tela os números de 10 a 50, de 5 em 5, desta vez usando a estrutura de
//repetição "para"

var
 contador: inteiro

inicio
   para contador de 10 ate 50 passo 5  faca
        escreva(contador) // poderia ter colocado , aspas depois de contador
   fimpara

fimalgoritmo